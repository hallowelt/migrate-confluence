<xml xmlns:ac="sample_namespace" xmlns:ri="sample_second_namespace">
    <!-- Row 1: Page, plain-text -->
    <div>
        <ac:link><ri:page ri:space-key="ABC" ri:content-title="SomePage"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 2: Page, rich-text -->
    <div>
        <ac:link><ri:page ri:space-key="ABC" ri:content-title="SomePage"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 3: Page, none -->
    <div>
        <ac:link><ri:page ri:space-key="ABC" ri:content-title="SomePage"/></ac:link>
    </div>

    <!-- Row 4: Blog post, plain-text -->
    <div>
        <ac:link><ri:blog-post ri:space-key="ABC" ri:content-title="Some Blog Post" ri:posting-day="2012/01/30"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 5: Blog post, rich-text -->
    <div>
        <ac:link><ri:blog-post ri:space-key="ABC" ri:content-title="Some Blog Post" ri:posting-day="2012/01/30"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 6: Blog post, none -->
    <div>
        <ac:link><ri:blog-post ri:space-key="ABC" ri:content-title="Some Blog Post" ri:posting-day="2012/01/30"/></ac:link>
    </div>

    <!-- Row 7: Attachment (relative), plain-text -->
    <div>
        <ac:link><ri:attachment ri:filename="SomeImage.png"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 8: Attachment (relative), rich-text -->
    <div>
        <ac:link><ri:attachment ri:filename="SomeImage.png"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 9: Attachment (relative), none -->
    <div>
        <ac:link><ri:attachment ri:filename="SomeImage.png"/></ac:link>
    </div>

    <!-- Row 10: Attachment (absolute), plain-text -->
    <div>
        <ac:link><ri:attachment ri:filename="SomeImage.png"><ri:page ri:space-key="ABC" ri:content-title="SomePage"/></ri:attachment><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 11: Attachment (absolute), rich-text -->
    <div>
        <ac:link><ri:attachment ri:filename="SomeImage.png"><ri:page ri:space-key="ABC" ri:content-title="SomePage"/></ri:attachment><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 12: Attachment (absolute), none -->
    <div>
        <ac:link><ri:attachment ri:filename="SomeImage.png"><ri:page ri:space-key="ABC" ri:content-title="SomePage"/></ri:attachment></ac:link>
    </div>

    <!-- Row 13: External URL, plain-text -->
    <div>
        <ac:link><ri:url ri:value="http://example.org/x.gif"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 14: External URL, rich-text -->
    <div>
        <ac:link><ri:url ri:value="http://example.org/x.gif"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 15: External URL, none -->
    <div>
        <ac:link><ri:url ri:value="http://example.org/x.gif"/></ac:link>
    </div>

    <!-- Row 16: Shortcut, plain-text -->
    <div>
        <ac:link><ri:shortcut ri:key="jira" ri:parameter="ABC-123"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 17: Shortcut, rich-text -->
    <div>
        <ac:link><ri:shortcut ri:key="jira" ri:parameter="ABC-123"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 18: Shortcut, none -->
    <div>
        <ac:link><ri:shortcut ri:key="jira" ri:parameter="ABC-123"/></ac:link>
    </div>

    <!-- Row 19: User, plain-text -->
    <div>
        <ac:link><ri:user ri:userkey="abc123"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 20: User, rich-text -->
    <div>
        <ac:link><ri:user ri:userkey="abc123"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 21: User, none -->
    <div>
        <ac:link><ri:user ri:userkey="abc123"/></ac:link>
    </div>

    <!-- Row 22: Space, plain-text -->
    <div>
        <ac:link><ri:space ri:space-key="ABC"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 23: Space, rich-text -->
    <div>
        <ac:link><ri:space ri:space-key="ABC"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 24: Space, none -->
    <div>
        <ac:link><ri:space ri:space-key="ABC"/></ac:link>
    </div>

    <!-- Row 25: Content by ID, plain-text -->
    <div>
        <ac:link><ri:content-entity ri:content-id="123"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 26: Content by ID, rich-text -->
    <div>
        <ac:link><ri:content-entity ri:content-id="123"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 27: Content by ID, none -->
    <div>
        <ac:link><ri:content-entity ri:content-id="123"/></ac:link>
    </div>

    <!-- Row 28: Anchor (same page), plain-text -->
    <div>
        <ac:link ac:anchor="Section Heading"><ac:plain-text-link-body><![CDATA[Click here]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 29: Anchor (same page), rich-text -->
    <div>
        <ac:link ac:anchor="Section Heading"><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 30: Anchor (same page), none -->
    <div>
        <ac:link ac:anchor="Section Heading"/>
    </div>

    <!-- Row 31: Anchor (other page), plain-text -->
    <div>
        <ac:link ac:anchor="anchor"><ri:page ri:content-title="SomePage"/><ac:plain-text-link-body><![CDATA[Text]]></ac:plain-text-link-body></ac:link>
    </div>

    <!-- Row 32: Anchor (other page), rich-text -->
    <div>
        <ac:link ac:anchor="anchor"><ri:page ri:content-title="SomePage"/><ac:link-body>Some <strong>Rich</strong> Text</ac:link-body></ac:link>
    </div>

    <!-- Row 33: Anchor (other page), none -->
    <div>
        <ac:link ac:anchor="anchor"><ri:page ri:content-title="SomePage"/></ac:link>
    </div>

    <!-- Row 34: Current page (empty link), none -->
    <div>
        <ac:link/>
    </div>

    <!-- Row 35: External URL (plain HTML) -->
    <div>
        <a href="http://www.atlassian.com">Atlassian</a>
    </div>

    <!-- Row 36: Page via macro param, ac:link-wrapped -->
    <ac:structured-macro ac:name="include">
        <ac:parameter ac:name="">
            <ac:link><ri:page ri:content-title="SomePage" ri:space-key="ABC"/></ac:link>
        </ac:parameter>
    </ac:structured-macro>

    <!-- Row 37: Space via macro param, bare RI -->
    <ac:structured-macro ac:name="create-from-template" ac:schema-version="1" ac:macro-id="mid-1">
        <ac:parameter ac:name="templateId">123456</ac:parameter>
        <ac:parameter ac:name="spaceKey"><ri:space ri:space-key="DOCTHEME"/></ac:parameter>
        <ac:parameter ac:name="buttonLabel">Create</ac:parameter>
    </ac:structured-macro>

    <!-- Row 38: Page via macro param, plain-text title -->
    <p>
        <ac:structured-macro ac:name="excerpt-include">
            <ac:default-parameter>Some page</ac:default-parameter>
        </ac:structured-macro>
    </p>

    <!-- Row 39: Image from attachment -->
    <ac:image><ri:attachment ri:filename="SomeImage.png"/></ac:image>

    <!-- Row 40: Image from URL -->
    <ac:image><ri:url ri:value="http://example.org/logo.png"/></ac:image>
</xml>
