#!/usr/bin/env php
<?php

declare( strict_types=1 );

/**
 * Reflects over the public static methods of the hook classes listed in
 * HOOK_CLASSES, reads their PHPDoc, warns about undocumented hooks, and
 * writes doc/hooks.md. The hook name is derived from the method name, a
 * void return type marks an action, anything else a filter.
 */

require __DIR__ . '/../vendor/autoload.php';

use HalloWelt\MigrateConfluence\Utility\Hooks\AnalyzerHooks;
use HalloWelt\MigrateConfluence\Utility\Hooks\ComposerHooks;
use HalloWelt\MigrateConfluence\Utility\Hooks\ConverterHooks;
use HalloWelt\MigrateConfluence\Utility\Hooks\ExtractorHooks;
use HalloWelt\MigrateConfluence\Utility\Hooks\Hooks;

/** Add new hook classes here. */
const HOOK_CLASSES = [
	AnalyzerHooks::class,
	ExtractorHooks::class,
	ConverterHooks::class,
	ComposerHooks::class,
];

$srcDir  = realpath( __DIR__ . '/../src' );
$docFile = realpath( __DIR__ . '/../doc' ) . '/hooks.md';


/**
 * Docblock parser
 *
 * @return array{description:string,since:string|null,params:list<array{type:string,name:string,description:string}>}
 */
function parseDocblock( string $docblock ): array {
	$info = [
		'description' => '',
		'since'       => null,
		'params'      => [],
	];

	$descLines = [];

	foreach ( preg_split( '/\r?\n/', $docblock ) as $line ) {
		// Strip /** ... */ framing characters
		$line = preg_replace( '/^\s*\/\*+\s*/', '', $line );
		$line = preg_replace( '/\s*\*+\/\s*$/', '', $line );
		$line = preg_replace( '/^\s*\*\s?/', '', $line );
		$line = trim( $line );

		if ( $line === '' ) {
			continue;
		}

		if ( preg_match( '/^@since\s+(.+)/', $line, $m ) ) {
			$info['since'] = trim( $m[1] );
		} elseif ( preg_match( '/^@param\s+(\S+)\s+(\$\S+)\s*(.*)/', $line, $m ) ) {
			$info['params'][] = [
				'type'        => $m[1],
				'name'        => $m[2],
				'description' => trim( $m[3] ),
			];
		} elseif ( !str_starts_with( $line, '@' ) ) {
			$descLines[] = $line;
		}
	}

	$info['description'] = implode( ' ', $descLines );
	return $info;
}

// ---------------------------------------------------------------------------
// Main scan
// ---------------------------------------------------------------------------

$hooks    = [];   // keyed by hookName
$warnings = [];

foreach ( HOOK_CLASSES as $class ) {
	$reflClass = new ReflectionClass( $class );
	$relPath = ltrim( str_replace( $srcDir, '', $reflClass->getFileName() ), DIRECTORY_SEPARATOR );

	foreach ( $reflClass->getMethods( ReflectionMethod::IS_PUBLIC | ReflectionMethod::IS_STATIC ) as $method ) {
		// Skip inherited helpers like Hooks::hookName()
		if ( $method->getDeclaringClass()->getName() !== $class ) {
			continue;
		}

		$name = Hooks::hookName( $method->getName() );
		$docblock = $method->getDocComment();
		if ( $docblock === false ) {
			$warnings[] = "WARNING: hook {$class}::{$method->getName()}() has no PHPDoc block.";
			continue;
		}

		$returnType = $method->getReturnType();
		$hooks[$name] = array_merge( parseDocblock( $docblock ), [
			'hookName' => $name,
			'hookType' => (string)$returnType === 'void' ? 'action' : 'filter',
			'file' => $relPath,
			'line' => $method->getStartLine(),
		] );
	}
}

// ---------------------------------------------------------------------------
// Write warnings to STDERR
// ---------------------------------------------------------------------------

foreach ( $warnings as $warning ) {
	fwrite( STDERR, $warning . PHP_EOL );
}

// ---------------------------------------------------------------------------
// Render Markdown
// ---------------------------------------------------------------------------

$filters = array_filter( $hooks, static fn( $h ) => $h['hookType'] === 'filter' );
$actions = array_filter( $hooks, static fn( $h ) => $h['hookType'] === 'action' );
ksort( $filters );
ksort( $actions );

$md  = "# Available Hooks\n\n";
$md .= "> This file is auto-generated by `bin/document-hooks`. Do not edit manually.\n\n";
$md .= "Hooks allow to attach code snippets, referenced from your configuration file, to intercept and adapt the normal run of the tool.\n\n";
$md .= "See the [documentation](how_to_use_hooks.md) for a detailed explanation.\n\n";

function renderHooks( array $hooks ): string {
	$out = '';
	foreach ( $hooks as $hook ) {
		$out .= "### `{$hook['hookName']}`\n\n";

		if ( $hook['description'] !== '' ) {
			$out .= "{$hook['description']}\n\n";
		}

		if ( $hook['since'] !== null ) {
			$out .= "**Since:** [{$hook['since']}](https://github.com/hallowelt/migrate-confluence/releases/tag/{$hook['since']})\n\n";
		}

		if ( !empty( $hook['params'] ) ) {
			$out .= "**Parameters:**\n\n";
			foreach ( $hook['params'] as $param ) {
				$desc = $param['description'] !== '' ? " — {$param['description']}" : '';
				$out .= "- `{$param['name']}` _{$param['type']}_{$desc}\n";
			}
			$out .= "\n";
		}

		$out .= "_Defined in [`{$hook['file']}`](../src/{$hook['file']}#L{$hook['line']}) at line {$hook['line']}._\n\n";
	}
	return $out;
}

if ( !empty( $filters ) ) {
	$md .= "## Filters\n\n";
	$md .= "Filters allow modifying a concrete value.\n\n";
	$md .= renderHooks( $filters );
}

if ( !empty( $actions ) ) {
	$md .= "## Actions\n\n";
	$md .= "Actions allow executing side-effect code at a specific point.\n\n";
	$md .= renderHooks( $actions );
}

if ( empty( $filters ) && empty( $actions ) ) {
	$md .= "_No hooks found._\n";
}

file_put_contents( $docFile, $md );
fwrite( STDOUT, "Generated {$docFile}\n" );

exit( empty( $warnings ) ? 0 : 1 );
