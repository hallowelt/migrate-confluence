<!--
Behavior summary:
- Uses conditions directly when present.
- Falls back to categories derived from labels when conditions is empty.
- Uses max as DPL count.
- Uses sort as DPL ordermethod when provided.
- Uses reverse=true/yes to set order=descending.
- Uses showSpace to choose default display path when path is not set:
  showSpace set -> fullpagename, otherwise -> pagename.
-->
</noinclude><includeonly>{{#dpl:
{{#if:{{{conditions|}}}|{{#arraymap:{{{conditions}}}|,|@@|{{!}}@@}}|
|category={{#arraymap:{{{labels|}}}|,|@@|@@|{{!}}}}
}}
|mode=unordered
|format=,\n* {{#switch:{{{path|{{#if:{{{showSpace|}}}|fullpagename|pagename}}}}}|fullpagename=[[ %PAGE% ]]|basepagename=[[ %PAGE%|{{BASEPAGENAME:%PAGE%}} ]]|subpagename=[[ %PAGE%|{{SUBPAGENAME:%PAGE%}} ]]|#default=[[ %PAGE%|{{PAGENAME:%PAGE%}} ]]}}
{{#if:{{{sort|}}}|{{!}}ordermethod={{{sort}}}|}}
{{#switch:{{lc:{{{reverse|}}}}}|true={{!}}order=descending|yes={{!}}order=descending|#default=}}
|count={{{max|999}}}
}}</includeonly>