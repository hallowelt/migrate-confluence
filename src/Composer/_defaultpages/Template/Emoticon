            "type": "string",
            "required": true
        },
        "alt": {
            "label": {
                "en": "Alternative text",
                "de": "Alternativtext"
            },
            "description": {
                "en": "Accessible label (aria-label) describing the emoticon. Falls back to the character itself if omitted.",
                "de": "Barrierefreie Beschreibung (aria-label) des Emoticons. Wird bei fehlender Angabe durch das Zeichen selbst ersetzt."
            },
            "type": "string",
            "suggested": true
        }
    },
    "paramOrder": [
        "char",
        "alt"
    ]
}
