    "params": {
        "char": {
            "label": {
                "en": "Character",
                "de": "Zeichen"
            },
            "description": {
                "en": "The Unicode emoticon/emoji character(s) to display.",
                "de": "Das darzustellende Unicode-Emoticon-/Emoji-Zeichen."
