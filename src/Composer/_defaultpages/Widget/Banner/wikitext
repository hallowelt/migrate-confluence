/* Mirrors the side padding of #main in BlueSpiceDiscovery (2.5rem, 1rem on small screens) */
#main::before {
	--banner-pad: 2.5rem;
	content: "";
	display: block;
	margin: -1rem calc( -1 * var( --banner-pad ) ) 1rem;
	max-width: calc( 100% + 2 * var( --banner-pad ) );
<!--{if $h}-->
	height: <!--{$h}-->px;
<!--{else}-->
	/* Confluence default: 18.42% of the content width, at least 140px */
	aspect-ratio: 5.4286;
	min-height: 140px;
	max-height: 750px;
<!--{/if}-->
	background: url("<!--{$u}-->") center / cover no-repeat;
}
@media ( max-width: 767px ) {
	#main::before { --banner-pad: 1rem; }
